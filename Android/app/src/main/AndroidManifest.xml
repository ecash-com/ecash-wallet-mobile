<?xml version="1.0" encoding="utf-8"?>
<!-- This AndroidManifest.xml template was generated by Skip -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <!-- example permissions for using device location -->
    <!-- <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/> -->
    <!-- <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/> -->

    <!-- permissions needed for using the internet or an embedded WebKit browser -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" /> -->

    <!-- Biometric/device-credential prompt gating the Backup seed reveal -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Show push notifications (Android 13+/API 33 runtime permission). FCM token registration via
         GMS doesn't need it; displaying a notification does. Used only for manual broadcast
         announcements — see docs/notifications.md. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- No Android auto-backup (allowBackup=false). The seed is the ONLY backup, and it lives in the
         Keystore-bound SkipKeychain which can't be restored to another device anyway. When backup was
         ON we excluded just the keychain, so a reinstall restored the public wallet-list METADATA
         without its seed → the app saw `hasWallets == true`, armed app-lock, and prompted biometrics
         "before the first wallet" on what looked like a fresh install (a seedless zombie wallet).
         allowBackup=false makes a reinstall a true clean slate. The rules files below are kept as
         defense-in-depth in case backup is ever re-enabled. -->
    <application
        android:label="eCash.com"
        android:icon="@mipmap/ic_launcher"
        android:name=".AndroidAppMain"
        android:supportsRtl="true"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        >
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|mnc|colorMode|density|fontScale|fontWeightAdjustment|keyboard|layoutDirection|locale|mcc|navigation|smallestScreenSize|touchscreen|uiMode"
            android:theme="@style/Theme.AppCompat.DayNight.NoActionBar"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Payment links. `launchMode="singleTask"` above is load-bearing: the default
                 (`standard`) never calls onNewIntent, so a link tapped while the app is running
                 would stack a SECOND MainActivity instead of reaching the live one, and the
                 warm-start half of this feature would silently do nothing. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="bitcoin" />
                <data android:scheme="ecash" />
            </intent-filter>
        </activity>

        <!-- Firebase Cloud Messaging (SkipFirebaseMessaging). The service receives messages and the
             SDK auto-displays notification messages; meta-data sets the default channel, the small
             icon (our white logo silhouette), and the accent color. Replaces the old bare-C2DM
             PushMessageReceiver (skip-notify is gone). -->
        <service
            android:name="skip.firebase.messaging.MessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="tools.skip.firebase.messaging" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />
    </application>
</manifest>
