// The configuration file for your Skip App (https://skip.dev).
// Properties specified here are shared between
// Darwin/ECashWalletMobile.xcconfig and Android/settings.gradle.kts
// and will be included in the app's metadata files
// Info.plist and AndroidManifest.xml

// PRODUCT_NAME is the default title of the app, which must match the app's Swift module name
PRODUCT_NAME = ECashWalletMobile

// PRODUCT_BUNDLE_IDENTIFIER is the unique id for both the iOS and Android app
PRODUCT_BUNDLE_IDENTIFIER = com.ecash.mobile.wallet

// The semantic version of the app
MARKETING_VERSION = 0.2.2

// The build number specifying the internal app version
CURRENT_PROJECT_VERSION = 13

// The package name for the Android entry point, referenced by the AndroidManifest.xml
ANDROID_PACKAGE_NAME = ecash.wallet.mobile

// If your Android appId is different from the iOS Bundle Identifer, specify it here.
// UNSET 2026-08-11: both platforms are now on com.ecash.mobile.wallet under the eCash orgs, so the
// Android-only override is redundant. Leave it commented — while it was set, Darwin/fastlane/Appfile
// (`ANDROID_APPLICATION_ID || PRODUCT_BUNDLE_IDENTIFIER`) resolved the iOS app_identifier to the
// ANDROID id, which would have pointed a TestFlight upload at the wrong app.
// ANDROID_APPLICATION_ID = com.ecash.mobile.wallet
