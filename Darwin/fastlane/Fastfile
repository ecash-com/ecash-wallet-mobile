# This file contains the fastlane.tools configuration
# for the iOS half of the Skip app.
# You can find the documentation at https://docs.fastlane.tools

default_platform(:ios)

lane :assemble do |options|
  # only build the iOS side of the app
  ENV["SKIP_ZERO"] = "true"
  # Release signs MANUALLY with the App Store profile that `get_provisioning_profile` just created
  # and installed (its name lands in SIGH_PROFILE_NAME). Automatic signing can't be used headlessly
  # here: it selects the identity itself — refusing a pinned "Apple Distribution" — and can only
  # create the development profile it then wants if an Xcode account is signed in on the machine.
  # Passing the profile explicitly keeps the archive reproducible on any machine, CI included.
  bundle_id = ENV['PRODUCT_BUNDLE_IDENTIFIER']
  profile = options[:profile_name] ||
            ENV["sigh_#{bundle_id}_appstore_profile-name"] ||
            "#{bundle_id} AppStore"
  signing_args = profile ? " PROVISIONING_PROFILE_SPECIFIER=\"#{profile}\"" : ""
  build_app(
    scheme: "ECashWalletMobile App",
    sdk: "iphoneos",
    xcconfig: "fastlane/AppStore.xcconfig",
    # -allowProvisioningUpdates lets xcodebuild fetch/refresh profiles rather than failing outright.
    # The project signs with CODE_SIGN_STYLE = Automatic, so an archive wants an "iOS App
    # Development" profile when Release is misconfigured to sign with an Apple Development
    # identity (fixed in project.pbxproj: Release now uses Apple Distribution). Under
    # the old team that profile happened to be cached locally from earlier Xcode use; a new team +
    # new bundle id has nothing cached, so the build failed with "No profiles ... were found.
    # Automatic signing is disabled and unable to generate a profile." Passing the key here (gym
    # doesn't inherit it from the lane) is what makes automatic signing actually work headlessly.
    xcargs: "-skipPackagePluginValidation -skipMacroValidation -allowProvisioningUpdates" + signing_args,
    derived_data_path: "../.build/Darwin/DerivedData",
    output_directory: "../.build/fastlane/Darwin",
    skip_archive: ENV["FASTLANE_SKIP_ARCHIVE"] == "YES",
    skip_codesigning: ENV["FASTLANE_SKIP_CODESIGNING"] == "YES"
  )
end

lane :beta do |options|
  desc "Build and upload to TestFlight (no App Store review submission)"
  get_provisioning_profile(api_key_path: "fastlane/apikey.json")
  assemble
  upload_to_testflight(
    api_key_path: "fastlane/apikey.json",
    # Don't block the lane on Apple's server-side processing; check TestFlight when it's ready.
    skip_waiting_for_build_processing: true
  )
end

lane :release do |options|
  desc "Build and release app (submits for App Store review — use :beta for TestFlight first)"

  # see https://docs.fastlane.tools/uploading-app-privacy-details/
  #upload_app_privacy_details_to_app_store(json_path: "fastlane/app_privacy_details.json")

  # if you have an apikey.json file (https://developer.apple.com/documentation/appstoreconnectapi/creating-api-keys-for-app-store-connect-api), fastlane can automatically fetch certificates and the ASC authentication information
  #get_certificates(api_key_path: "fastlane/apikey.json")
  get_provisioning_profile(api_key_path: "fastlane/apikey.json")

  assemble

  upload_to_app_store(
    api_key_path: "fastlane/apikey.json",
    app_rating_config_path: "fastlane/metadata/rating.json",
    release_notes: { default: "Fixes and improvements." }
  )
end

