<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Allow cleartext HTTP to localhost / .local. Lets the iOS Simulator reach a dev CoinNews
	     indexer on the host (e.g. BitWindow at http://127.0.0.1:30301). NSAllowsLocalNetworking is
	     the App-Store-sanctioned ATS exception (local only) — production endpoints are https. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.ecash.mobile.wallet</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>bitcoin</string>
				<string>ecash</string>
			</array>
		</dict>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- NOTE: NSAllowsLocalNetworking is deliberately ABSENT while the blanket allow below is
		     in place. iOS 10+ IGNORES NSAllowsArbitraryLoads (treating it as NO) whenever
		     NSAllowsLocalNetworking, NSAllowsArbitraryLoadsInWebContent or
		     NSAllowsArbitraryLoadsForMedia is also present — the more specific key wins. Having
		     both is why the exception silently did nothing on the first attempt. Arbitrary loads
		     covers local networking anyway; restore this key when the blanket allow is reverted. -->
		<!-- TEMPORARY (2026-08-26), paired with the .thunder entry in WalletNetwork.selectable:
		     REVERT BOTH TOGETHER. The Thunder test node is plain HTTP on a bare IP
		     (http://157.180.96.24:16009), and ATS refuses cleartext with error -1022.
		     NSExceptionDomains can't help — ATS exceptions match domain NAMES, never IP
		     literals — so a blanket allow is the only option until the node gets a domain
		     with TLS, which is expected shortly.

		     This disables ATS for EVERY request the app makes, not just Thunder. It must not
		     ship: App Store review asks for justification, and it would weaken the Esplora,
		     CoinNews and price-feed connections too. -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
